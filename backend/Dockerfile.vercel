# Stage 1: Build da aplicação .NET 9
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copiar arquivos de projeto e restaurar dependências em cache
COPY ImovPlan.slnx ./
COPY Core/ImovPlan.Domain/ImovPlan.Domain.csproj Core/ImovPlan.Domain/
COPY Core/ImovPlan.Application/ImovPlan.Application.csproj Core/ImovPlan.Application/
COPY Infrastructure/ImovPlan.Infrastructure/ImovPlan.Infrastructure.csproj Infrastructure/ImovPlan.Infrastructure/
COPY Presentation/ImovPlan.API/ImovPlan.API.csproj Presentation/ImovPlan.API/
RUN dotnet restore Presentation/ImovPlan.API/ImovPlan.API.csproj

# Copiar todo o código fonte do backend
COPY . ./
WORKDIR /src/Presentation/ImovPlan.API
RUN dotnet publish ImovPlan.API.csproj -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Runtime ASP.NET Core
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Instalar utilitários: curl para healthcheck e libcap2-bin para conceder permissão de bind em portas baixas (<1024) para usuário sem root (app)
RUN apt-get update && apt-get install -y --no-install-recommends curl libcap2-bin && \
    setcap 'cap_net_bind_service=+ep' /usr/share/dotnet/dotnet && \
    apt-get purge -y libcap2-bin && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

# A Vercel encaminha o tráfego HTTP para a porta $PORT (padrão 80 se não especificado)
ENV PORT=80
EXPOSE 80 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD /bin/sh -c 'curl -fsS http://localhost:${PORT:-80}/health || exit 1'

USER app

# Inicializa o ASP.NET Core escutando na porta fornecida pela Vercel
ENTRYPOINT ["/bin/sh", "-c", "export ASPNETCORE_URLS=http://+:${PORT:-80}; exec dotnet ImovPlan.API.dll"]
