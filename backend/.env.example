# ─── Chaves JWT ────────────────────────────────────────────────────────────────
# Mínimo 32 bytes. Em produção, gere com: openssl rand -base64 32
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_FORTE_MIN_32_CHARS"

# ─── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_CONNECTION_STRING="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGO_DATABASE_NAME="ImovPlanDb"

# ─── IA (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY="sua_chave_groq_aqui"

# ─── Google OAuth ────────────────────────────────────────────────────────────────
# Client ID do Google (obtido no Google Cloud Console)
# Usado no backend para validar o ID Token recebido do frontend
GOOGLE_CLIENT_ID="seu_google_client_id.apps.googleusercontent.com"

# ─── Hosts permitidos ───────────────────────────────────────────────────────────
# Em desenvolvimento: appsettings.json já define "localhost;127.0.0.1"
# Em produção, defina esta variável de ambiente para restringir ao domínio real:
#   ASPNETCORE_ALLOWED_HOSTS=api.imovplan.com.br
# No docker-compose.yml, adicione em environment:
#   - ASPNETCORE_ALLOWED_HOSTS=api.imovplan.com.br
ASPNETCORE_ALLOWED_HOSTS=api.imovplan.com.br

# ─── Configurações de Email (Resend) ─────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ─── Keep Alive ──────────────────────────────────────────────────────────────────
# URL da própria API para que ela faça requisições nela mesma a cada 10 minutos
# Evita que a aplicação entre em estado de sleep (hibernação) em serviços como Render.
# Ex: https://api.imovplan.com.br
KEEP_ALIVE_URL=""