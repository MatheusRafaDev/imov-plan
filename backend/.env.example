# === IMOVPLAN ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in the values

# JWT Secret Key (generate a strong key: openssl rand -base64 32)
# WARNING: This is a SENSITIVE value. Never commit the real key.
# In production, rotate this key regularly via environment variable Jwt__Key or JWT:Key
# .NET maps Jwt__Key to configuration key Jwt:Key
Jwt__Key=

# Groq API Key for AI consulting feature
GROQ_API_KEY=""

# MongoDB Connection String (default: mongodb://localhost:27017)
# MONGO_CONNECTION_STRING="mongodb://localhost:27017"

# MongoDB Database Name (default: ImovPlanDb)
# MONGO_DATABASE_NAME="ImovPlanDb"