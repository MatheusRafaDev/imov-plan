# === IMOVPLAN ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in the values.
# Keep the local .env out of source control.

# JWT configuration
# WARNING: This is a sensitive secret. Never commit the real key.
Jwt__Key=YOUR_VERY_LONG_JWT_SECRET_KEY_AT_LEAST_32_BYTES_LONG_12345
Jwt__Issuer=ImovPlan
Jwt__Audience=ImovPlan
Jwt__ExpirationInHours=24

# Optional external API keys / secrets
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# MongoDB configuration
MongoDbSettings__ConnectionString=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MongoDbSettings__DatabaseName=ImovPlanDb

# CORS allowed origins
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000
Cors__AllowedOrigins__2=http://127.0.0.1:3000
