# ─── Chaves JWT ────────────────────────────────────────────────────────────────
# Mínimo 32 bytes. Em produção, gere com: openssl rand -base64 32
Jwt__Key="SUBSTITUA_POR_UMA_CHAVE_FORTE_MIN_32_CHARS"

# ─── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_CONNECTION_STRING="mongodb://localhost:27017"
MONGO_DATABASE_NAME="ImovPlanDb"

# ─── IA (Groq) ─────────────────────────────────────────────────────────────────
GROQ_API_KEY="sua_chave_groq_aqui"

# ─── Hosts permitidos ───────────────────────────────────────────────────────────
# Em desenvolvimento: appsettings.json já define "localhost;127.0.0.1"
# Em produção, defina esta variável de ambiente para restringir ao domínio real:
#   ASPNETCORE_AllowedHosts=api.imovplan.com.br
# No docker-compose.yml, adicione em environment:
#   - ASPNETCORE_AllowedHosts=api.imovplan.com.br
ASPNETCORE_AllowedHosts=api.imovplan.com.br

# ─── Configurações de Email (Resend) ─────────────────────────────────────────
FrontendUrl="http://localhost:3000"
