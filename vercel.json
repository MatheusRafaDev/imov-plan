{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "api": {
      "root": "backend",
      "framework": "container",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/web"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://{{project-name}}.vercel.app"
  }
}
