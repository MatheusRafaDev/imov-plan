{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": {
        "service": "backend",
        "path": "/api/:match*"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web",
        "path": "/:path*"
      }
    }
  ]
}