# ==============================================================================
# Variáveis de Ambiente - Frontend (Next.js)
# ==============================================================================
# Renomeie este arquivo para .env.local para uso em desenvolvimento
# ==============================================================================

# URL da API do Backend (obrigatório)
# Exemplo local: http://localhost:5179
NEXT_PUBLIC_API_URL=http://localhost:5179

# URL Base da Aplicação Frontend (útil para links de compartilhamento/SEO)
# Exemplo local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Google OAuth
# ==============================================================================
# Client ID do Google (obtido no Google Cloud Console)
# Precisa ser configurado no Google Cloud Console com as origens autorizadas:
# - http://localhost:3000 (desenvolvimento)
# - https://seu-dominio.com (produção)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# ==============================================================================
# Chaves de API e Integrações (Exemplos Futuros)
# ==============================================================================

# Autenticação (ex: Clerk, NextAuth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Analytics (ex: Google Analytics, Vercel Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Integrações de Terceiros (se houver, como serviços de e-mail, mapas, etc)
# NEXT_PUBLIC_MAPS_API_KEY=
